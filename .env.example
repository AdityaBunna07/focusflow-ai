# Create a key in Google AI Studio, then copy this file to .env and add your key.
GEMINI_API_KEY=replace_with_your_key
# Optional: override only if your Google AI Studio account exposes a different Gemma model.
GEMMA_MODEL=gemma-4-26b-a4b-it
# Optional Google-account execution settings. credentials.json and token.json are ignored by Git.
FLASK_SECRET_KEY=replace_with_a_long_random_string
FOCUSFLOW_TIMEZONE=Asia/Kolkata

